module Env

// Check the environment variable `ENVIRONMENT`, if it exists, and use the appropriate environment file
hidden detectedEnv: String? = read?("env:ENVIRONMENT")
hidden envFile: String = if (detectedEnv == "dev") ".env.development" else ".env"

// Read in the `.env*` file and parse it into a map for easy access
hidden env: Map<String, String> = read("../" + envFile).text.trimStart().split("\n")
  .filter((line) -> line.contains("="))
  .toMap(
    (line) -> line.substring(0, line.indexOf("=")),
    (line) -> line.substring(line.indexOf("=") + 1, line.length).trim()
  )
