module Env

hidden environmentName: String = read?("env:ENVIRONMENT") ?? "prod"

// Check the environment variable `ENVIRONMENT`, if it exists, and use the appropriate environment file
hidden envFile: String = if (environmentName == "dev") ".env.development" else ".env"

// The parsed environment vairables from the `.env` file
// Returns an empty Map when files are missing
hidden vars: Map<String, String> = let (envContent = read?("../" + envFile)?.text ?? "")(
  envContent
      .split("\n")
      .map((line) -> line.trim())
      .filter((line) -> line.contains("=") && !line.startsWith("#"))
      .toMap(
        (line) -> line.substring(0, line.indexOf("=")).trim(),
        (line) -> let (val = line.substring(line.indexOf("=") + 1, line.length).trim()) (
          // Strip surrounding quotes if present in `.env`
          if (val.startsWith("\"") && val.endsWith("\""))
            val.substring(1, val.length - 1)
          else val)))

function get(key: String, defaultValue: String?): String? =
  vars.getOrNull(key) ?? defaultValue
