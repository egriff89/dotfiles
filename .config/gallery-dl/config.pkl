// https://gdl-org.github.io/docs/configuration.html

import "extractors/BaseExtractor.pkl"
import "extractors/SchaleNetwork.pkl"
import "extractors/TwitterExtractor.pkl"

import "Downloader.pkl"
import "utility/Env.pkl"

extractor = (BaseExtractor.extractor) {
  schalenetwork = new SchaleNetwork.Extractor {
    crt = Env.env["SCHALE_CRT"]
    token = Env.env["SCHALE_BEARER_TOKEN"]
  }
  twitter = new TwitterExtractor.Extractor {
    videos = Env.env["TWT_VIDEOS"]
  }
}

downloader = Downloader.downloader
